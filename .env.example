# Copy to .env and fill in. Never commit the real .env.
TELEGRAM_TOKEN=123456:your-bot-token-from-BotFather
# Chat that receives new-order notifications (user or group ID)
ADMIN_CHAT_ID=123456789
# Comma-separated Telegram user IDs allowed to use /admin
ADMIN_IDS=123456789,987654321
SHOP_NAME=Pro Shop
# Language of admin notifications/panel: uz, ru or en
ADMIN_LANG=uz
# Name of the Google Spreadsheet (file) shared with the service account
SHEET_NAME=Mahsulotlar
# Optional
# CACHE_TTL=60
# FUZZY_THRESHOLD=65
# Where per-user state is stored (keep it on a volume in Docker)
# PERSISTENCE_FILE=data/bot_data.pickle
# Extra category emoji, merged over the built-in map
# CATEGORY_EMOJI=Kiyim=👕,Poyabzal=👞
# Service account JSON as a single line; if unset, credentials.json is used
# GOOGLE_CREDENTIALS=
